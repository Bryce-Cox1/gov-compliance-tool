# OpenAI API Key (required for rewriting functionality)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Model (optional, defaults to gpt-3.5-turbo for cost efficiency)
# Options: gpt-3.5-turbo (cheapest, 20x cheaper than GPT-4), gpt-4o-mini, gpt-4
OPENAI_MODEL=gpt-3.5-turbo
